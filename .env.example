# ---- Search provider ----
# Primary provider: tavily or serper
SEARCH_PROVIDER=tavily

# You only NEED the key for your primary provider above. But if you fill in
# BOTH keys, the app automatically falls back to the other provider whenever
# the primary one comes back empty (rate limit, quota exhausted, etc).
TAVILY_API_KEY=
SERPER_API_KEY=

# ---- LLM ----
# Which one actually does the reasoning/report-writing: groq or gemini
# Groq's free tier allows far more requests/minute than Gemini's — better for
# active testing. You only need to fill in the key for whichever you pick.
LLM_PROVIDER=groq

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

GEMINI_API_KEY=
# Check https://ai.google.dev for the current recommended free-tier flash model
# if this exact name is ever deprecated.
GEMINI_MODEL=gemini-3.5-flash

# ---- Cost / scope controls ----
MAX_QUERIES=15
MAX_RESULTS_PER_QUERY=6
MAX_SOURCES_TO_EXTRACT=8
CACHE_TTL_HOURS=24
# These three together keep the LLM request comfortably under Groq's free-tier
# 8000-token/request cap. Raise them if you switch to Gemini or a paid tier.
MAX_CHARS_PER_PAGE=500
MAX_CHARS_PER_SNIPPET=3000
MAX_EVIDENCE_SECTION_CHARS=14000
